<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>whill_bringup</name>
  <version>0.1.0</version>
  <description>real / sim / replay / mock の 4 モードを起動する launch</description>
  <maintainer email="ygnk0805@outlook.jp">systemlab</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>whill_mock_drivers</exec_depend>
  <exec_depend>whill_params</exec_depend>
  <exec_depend>whill_gateway</exec_depend>
  <!-- 既存スタック側。ノードだけ起動する（dispatch_launch.py は include
       しない — rosbridge と http.server が付いてきて ROS への口が増える）。 -->
  <exec_depend>whill_dispatch</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
